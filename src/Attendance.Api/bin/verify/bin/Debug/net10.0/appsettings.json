{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AttendanceDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "AttendanceApi",
    "Audience": "AttendanceSpa",
    "SecretKey": "dev-only-signing-key-change-in-production-0123456789abcdef0123456789abcdef",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "QrToken": {
    "ExpirySeconds": 15,
    "SweepIntervalSeconds": 5
  },
  "Kiosk": {
    "// ScanBaseUrl": "'auto' (default) detects this PC's LAN IP at startup and builds http://<ip>:<ScanPort>/scan — survives router IP reassignments with zero edits. Set an explicit URL to override.",
    "ScanBaseUrl": "auto",
    "ScanPort": 4200
  },
  "Auth": {
    "DefaultEmployeePassword": "Employee@123!"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
